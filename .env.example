# ─── Core ─────────────────────────────────────────────────────────────────────
# On Railway: set DATABASE_URL to the Railway Postgres ${{Postgres.DATABASE_URL}} variable
database_url=postgresql+asyncpg://user:pass@host:5432/dbname
# On Railway: set REDIS_URL to the Railway Redis ${{Redis.REDIS_URL}} variable
redis_url=redis://localhost:6379/0
secret_key=
jwt_algorithm=HS256
access_token_expire_minutes=15
refresh_token_expire_days=7
bcrypt_cost=12

# ─── Logging ──────────────────────────────────────────────────────────────────
log_level=INFO
# Leave log_file empty on Railway (logs go to stdout; Railway captures them)
log_file=logs/dfp.log
log_max_bytes=104857600
log_backup_count=5

# ─── Cloudinary ───────────────────────────────────────────────────────────────
cloudinary_cloud_name=
cloudinary_api_key=
cloudinary_api_secret=

# ─── AI providers ─────────────────────────────────────────────────────────────
gemini_api_key=
huggingface_api_key=
NVIDIA_API_KEY=
# "nvidia" uses Llama-3.3-70B via NVIDIA NIM (free tier) | "gemini" uses Gemini 2.5 Flash
DIGEST_PROVIDER=nvidia

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
github_client_id=
github_client_secret=
# On Railway: https://<your-railway-domain>/v1/auth/github/callback
github_redirect_uri=http://localhost:8000/v1/auth/github/callback
# On Railway: https://<your-railway-domain>/v1/integrations/github/callback
github_integration_redirect_uri=

# ─── Linear OAuth ─────────────────────────────────────────────────────────────
linear_client_id=
linear_client_secret=
# On Railway: https://<your-railway-domain>/v1/integrations/linear/callback
linear_redirect_uri=

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
slack_client_id=
slack_client_secret=
slack_signing_secret=
# On Railway: https://<your-railway-domain>/v1/integrations/slack/callback
slack_redirect_uri=http://localhost:8000/v1/integrations/slack/callback

# ─── Jira OAuth ───────────────────────────────────────────────────────────────
jira_client_id=
jira_client_secret=
# On Railway: https://<your-railway-domain>/v1/integrations/jira/callback
jira_redirect_uri=

# ─── Discord OAuth ────────────────────────────────────────────────────────────
discord_client_id=
discord_client_secret=
# Public key from Discord Developer Portal → App → General Information
discord_public_key=
# Bot token from Discord Developer Portal → App → Bot
discord_bot_token=
# On Railway: https://<your-railway-domain>/v1/integrations/discord/callback
discord_redirect_uri=http://localhost:8000/v1/integrations/discord/callback

# ─── CORS & Cookies ───────────────────────────────────────────────────────────
# On Railway: set to your frontend domain, e.g. https://your-app.vercel.app
allowed_origins=http://localhost:5173
# On Railway: set to your frontend domain
frontend_url=http://localhost:5173
# On Railway: set to your Railway API domain
backend_url=
# On Railway: set cookie_secure=True, cookie_samesite=none
cookie_secure=False
cookie_samesite=lax
csrf_token_expire_minutes=60

clickup_client_id=
clickup_client_secret=
clickup_redirect_uri=https://your-domain/integrations?connected=clickup
